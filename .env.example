# Application
APP_PORT=3000
APP_URL=http://localhost:3000
APP_NAME=QuizzApp

# Database
DB_NAME=quizz
DB_USER=quizz
DB_PASSWORD=quizz_secret

# Security — CHANGE THESE IN PRODUCTION
JWT_SECRET=change_me_in_production_please_use_long_random_string
JWT_REFRESH_SECRET=change_refresh_secret_too_use_different_random_string

# SMTP (optional — for password reset and invitations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@quizz.local
